{
	"framework": "vite",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"routes": [
		{
			"src": "/(.*)",
			"has": [{ "type": "host", "value": "fache.vercel.app" }],
			"status": 308,
			"headers": { "Location": "https://www.fache.com.ar/$1" }
		},
		{
			"src": "/assets/(.*)",
			"headers": { "Cache-Control": "public, max-age=31536000, immutable" },
			"continue": true
		},
		{
			"src": "/(backgrounds|vectors)/(.*)",
			"headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400" },
			"continue": true
		},
		{
			"src": "/favicon.ico",
			"headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400" },
			"continue": true
		},
		{
			"src": "/",
			"has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
			"headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
			"dest": "/index.md"
		},
		{
			"src": "/work/([^/.]+)/?",
			"has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
			"headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
			"dest": "/work/$1.md",
			"check": true
		},
		{
			"src": "/(?:work/[^/.]+/?)?",
			"headers": { "Vary": "Accept" },
			"continue": true
		},
		{ "src": "/(.*)\\.md", "headers": { "Content-Type": "text/markdown; charset=utf-8" }, "continue": true },
		{ "handle": "filesystem" },
		{ "src": "/work/([^/.]+)/?", "dest": "/work/$1.html", "check": true },
		{ "handle": "error" },
		{
			"src": "/.*",
			"has": [{ "type": "header", "key": "accept", "value": "(.*)text/markdown(.*)" }],
			"status": 404,
			"headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
			"dest": "/404.md"
		},
		{ "src": "/.*", "status": 404, "dest": "/404.html" }
	]
}
